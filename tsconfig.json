{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "jsxImportSource": "preact",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true, "noEmit": true, "isolatedModules": true, "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "test", "vite.config.ts"]
}
